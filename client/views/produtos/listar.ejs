<%- include('../partials/header') %>

<div class="container">
    <h2>Painel do Ofertante</h2>
    <p>Área exclusiva para gerenciar seu desapego e visualizar seus contatos de troca.</p>
    
    <a href="/produtos/cadastro" class="btn btn-secondary" style="margin-bottom: 30px;">+ Anunciar Novo Produto</a>


    <!-- SEÇÃO LISTAR PRODUTOS -->
    <h3>Meu Catálogo Registrado</h3>
    <table class="tabela-dados">
        <thead>
            <tr>
                <th>Foto e Item</th>
                <th style="text-align: center;">Status na Vitrine</th>
                <th style="text-align: center;">Condição</th>
                <th style="text-align: center;">Ações Manuais</th>
            </tr>
        </thead>
        <tbody>
            <% produtos.forEach(function(p) { %>
                <tr>
                    <td style="display: flex; align-items: center; gap: 15px;">
                        <!-- Miniatura -->
                        <% if(p.foto) { %>
                            <img src="<%= p.foto %>" alt="Foto do Produto" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px; border: 1px solid var(--cor-borda);">
                        <% } else { %>
                            <div style="width: 60px; height: 60px; background: #EEE; border: 1px solid #CCC; text-align:center; line-height:60px; font-size:10px;">Sem Foto</div>
                        <% } %>
                        
                        <div>
                            <strong><%= p.nome %></strong> <br>
                            <small>R$ <%= p.preco %></small>
                        </div>
                    </td>
                    
                    <td style="text-align: center; vertical-align: middle;">
                        <% if(p.is_publico) { %>
                            <!-- Olho Aberto: Fundo Preto com Letra Branca -->
                            <span style="font-weight: bold; background-color: var(--cor-texto-principal); color: var(--cor-texto-inverso);  border-radius: 4px;">
                                <i class="fa-solid fa-eye"></i> Público
                            </span>
                        <% } else { %>
                            <!-- Olho Cortado: Vermelho Destaque -->
                            <span style="font-weight: bold; color: var(--cor-destaque);">
                                <i class="fa-solid fa-eye-slash"></i> Privado
                            </span>
                        <% } %>
                    </td>

                    <td style="text-align: center; vertical-align: middle;">
                        <%= p.condicao.toUpperCase() %>
                    </td>

                    <!-- Coluna de Ações com Botões FontAwesome -->
                    <td style="text-align: center; white-space: nowrap; vertical-align: middle;">
                        
                        <!-- BOTÃO DE TOGGLE DE STATUS -->
                        <form action="/produtos/alternar-visibilidade/<%= p.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn <%= p.is_publico ? 'btn-secondary' : 'btn-primary' %>" title="Ligar/Desligar da Vitrine">
                                <i class="fa-solid fa-power-off"></i> Alternar
                            </button>
                        </form>
                        
                        <!-- BOTÃO DE EDIÇÃO COM A ROTA NOVA -->
                        <a href="/produtos/editar/<%= p.id %>" class="btn">
                            <i class="fa-solid fa-pen"></i> Editar
                        </a>
                        
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
