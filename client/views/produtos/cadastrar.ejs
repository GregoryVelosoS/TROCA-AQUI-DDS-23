<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN : com o conteúdo da página-->
<main>
    <div class="container">
        <!-- Estilo do card geral -->
        <div class="card"
        style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); 
        background-color: var(--cor-fundo);">
            <!-- Texto inicial -->
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;"> 
                <i class="fa-solid "></i>
                CRIAR NOVO PRODUTO
            </h2>
            <!-- Formulário de cadastro -->
            <form action="/produtos/cadastrar" method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col">

                        <!-- Caixinha de nome -->
                         <div class="form-group">
                            <label for="nome">
                                Nome Completo      
                            </label>
                            <input type="text" id="nome" name="nome" class="form-control" required>
                         </div>

                        <!-- Caixinha de preço -->
                        <div class="form-group">
                            <label for="preco"> Preço</label>
                            <input type="number" step="0.01" id="preco" name="preco" class="form-control" required>
                        </div>

                        <!-- Caixinha de descricao -->
                         <div class="form-group">
                            <label for="descricao">
                                Descrição Completa    
                            </label>
                            <textarea id="descricao" name="descricao" class="form-control" rows="3"
                            placeholder="Qual o estado físico? Possui marcas de uso?" required></textarea>
                         </div>

                        <!-- Caixinha de condicao -->
                        <div class="form-group">
                            <label for="condicao"> Condição Atual</label>
                            <select name="condicao" id="condicao" class="form-control" required>
                                <option value="novo">Novo</option>
                                <option value="usado">Usado</option>
                            </select>
                        </div>

                    </div>
                    <!-- SEGUNDA COLUNA -->
                    <div class="col">

                        <!-- Caixinha de privacidade -->
                        <div class="form-group">
                            <label for="is_publico"> Visibilidade no Sistema</label>
                            <select name="is_publico" id="is_publico" class="form-control" required>
                                <option value="1">Público (Liberado na Vitrine)</option>
                                <option value="0">Privado (Apenas Rascunho, Oculto)</option>
                            </select>
                        </div>

                        <!-- Caixinha de foto -->
                        <div class="form-group">
                            <label for="foto"> Foto do produto</label>
                            <input type="file" name="foto" id="foto" class="form-control" accept="image/*" required>
                        </div>

                         <!-- PREVIEW DA IMAGEM -->
                          <div id="preview-box" class="preview-container max-width:100%" style="height: 230px;">
                            <img src="..." alt="Foto do produto" id="preview-img" style="height: 230px; width: auto;">
                          </div>
                    </div>
                </div>
                <!-- Botão de envio do formulário -->
                 <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                    <i class="fa-solid fa-check"></i> Postar Produto
                 </button>
            </form>
        </div>
    </div>
</main>

<!-- importa o footer -->
<%- include('../partials/footer') %>