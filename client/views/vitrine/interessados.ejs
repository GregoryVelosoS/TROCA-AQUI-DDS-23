<%- include('../partials/header') %>

<div class="container" style="max-width: 1000px;">
    
    <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="color: var(--cor-destaque); font-size: 32px;"><i class="fa-solid fa-store"></i> Vitrine de Trocas</h2>
        <p style="color: var(--cor-texto-secundario);">Navegue pelos produtos que estão sendo oferecidos pelos usuários da plataforma.</p>
    </div>

    <!-- GRID DOS CARDS DE PRODUTOS (Layout Automático e Responsivo) -->
    <div style="display: grid; grid-template-columns: repeat(1,1); gap: 25px;">
        
    <!-- NOVA SEÇÃO: PESSOAS INTERESSADAS (O JOIN DO SQL É EXIBIDO AQUI) -->
    <div style="border-left: 5px solid var(--cor-destaque); padding-left: 15px; margin-bottom: 40px;">
        <h3 style="color: var(--cor-destaque); margin-bottom: 5px;">Meus Leads (Interessados)</h3>
        <p style="font-size: 14px; margin-bottom: 15px;">Estes usuários clicaram em "Tenho Interesse" nos seus produtos públicos.</p>
        
        <% if(interessados && interessados.length > 0) { %>
            <table class="tabela-dados">
                <thead>
                    <tr>
                        <th>Data do Match</th>
                        <th>Qual Produto?</th>
                        <th>Pessoa</th>
                        <th>Contato (WhatsApp)</th>
                    </tr>
                </thead>
                <tbody>
                    <% interessados.forEach(function(i) { %>
                        <tr>
                            <!-- Formata a data do banco para o padrão brasileiro -->
                            <td style="padding: 10px; border: 1px solid var(--cor-borda);"><%= new Date(i.data_interesse).toLocaleDateString('pt-BR') %></td>
                            <td style="padding: 10px; border: 1px solid var(--cor-borda);">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <strong><%= i.nome_produto %></strong>
                                    <a href="/produtos/editar/<%= i.id_produto %>" class="btn btn-secondary" style="font-size: 11px; padding: 4px 8px; background-color: var(--cor-fundo); color: var(--cor-texto-principal); margin-left: 10px;">
                                        <i class="fa-solid fa-magnifying-glass"></i> Detalhes
                                    </a>
                                </div>
                            </td>
                            <td style="padding: 10px; border: 1px solid var(--cor-borda);"><%= i.nome_interessado %></td>
                            <td style="padding: 10px; border: 1px solid var(--cor-borda); font-weight: bold; color: var(--cor-destaque);">
                                <%= i.telefone_interessado %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div style="padding: 20px; border: 2px dashed var(--cor-borda); text-align: center;">
                Ainda não há interessados nos seus itens. Verifique se eles estão públicos na Vitrine!
            </div>
        <% } %>
    </div>

    </div>
</div>

<%- include('../partials/footer') %>
